# Google Gemini API Key for Face Liveness / Anti-spoofing Verification
# Get one for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Integration for Real-time Attendance Alerts
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram Group or Channel Chat ID (e.g. -100xxxxxxxxxx or your user ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
